const { normalizeText, cleanConversationalPrefixes } = require('../shared/string.util');

const INTENTS = Object.freeze({
  DIRECT_PRICE: 'DIRECT_PRICE',
  REQUEST_PHOTOS: 'REQUEST_PHOTOS',
  CONSULTATIVE_SALES: 'CONSULTATIVE_SALES',
  ORDER_REQUEST: 'ORDER_REQUEST',
  UPDATE_ORDER_DETAILS: 'UPDATE_ORDER_DETAILS',
  ORDER_CONFIRMATION: 'ORDER_CONFIRMATION',
  GENERAL_CHAT: 'GENERAL_CHAT',
});

const PRICE_TRIGGER_PATTERNS = [
  /\bqual (o )?(valor|preco)\b/,
  /\bquanto custa\b/,
  /\bquanto (e|ta|sai)\b/,
  /\bvalor d[aoe]\b/,
  /\bpreco d[aoe]\b/,
  /\btabela de preco\b/,
];

const PHOTO_TRIGGER_PATTERNS = [
  /\b(foto|fotos|imagem|imagens)\b/,
  /\bmostra(r)?\b/,
  /\bver foto(s)?\b/,
];

const ORDER_CLOSING_PATTERNS = [
  /\b(quero|vou) (fechar|levar|comprar|fazer o pedido)\b/,
  /\bconfirmo (o pedido)?\b/,
  /\bpode mandar o pix\b/,
  /\bqual a chave pix\b/,
  /^(sim|confirmo|pode confirmar|pode mandar|fechado|isso|ok|pode ser|confirma)\b/i,
];

const ORDER_INTENT_VERBS = [
  /\b(manda pra mim|manda para mim|manda|separa pra mim|separa para mim|separa|quero pedir|me ve|enviar pra mim|envia pra mim)\b/,
];

const UPDATE_DETAILS_PATTERNS = [
  /\b(hoje vai ser|vai ser n[oa]|muda (o|a)?\s*(pagamento|endereco|entrega)?|prefiro pagar|passa no|levar maquininha)\b/i,
  /\b(no debito|no débito|no credito|no crédito|em dinheiro|no dinheiro|via pix|no pix)\b/i,
  /^(debito|débito|credito|crédito|dinheiro|pix)$/i,
];

function parseOrderItems(rawMessage) {
  if (!rawMessage || typeof rawMessage !== 'string') {
    return [];
  }

  // Preserva delimitadores como vírgulas e " e " antes de limpar
  const cleanPunct = rawMessage
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9\s,;\n+]/g, ' ')
    .replace(/\b(manda pra mim|manda para mim|manda|separa pra mim|separa para mim|separa|quero pedir|quero|me ve|enviar pra mim|enviar|boa tarde|bom dia|boa noite|por favor|por gentileza)\b/g, ' ');

  const segments = cleanPunct
    .split(/[,;\n]|\s+e\s+|\s+\+\s+/)
    .map((s) => s.replace(/\s+/g, ' ').trim())
    .filter((s) => s.length > 0);

  const items = [];
  const quantityRegex = /^(\d+)\s*(?:x|\*|\s)\s*(.+)$|^(\d+)\s+(.+)$/;

  for (const seg of segments) {
    const match = seg.match(quantityRegex);
    if (match) {
      const qty = parseInt(match[1] || match[3], 10);
      const name = (match[2] || match[4]).trim();
      if (qty > 0 && name.length > 1) {
        items.push({ quantity: qty, rawName: name });
      }
    }
  }

  return items;
}

class MessageRouter {
  /**
   * @param {import('../catalog/catalog.repository').CatalogRepository} catalogRepository
   */
  constructor(catalogRepository) {
    if (!catalogRepository) {
      throw new Error('MessageRouter requires a CatalogRepository instance');
    }
    this.catalogRepository = catalogRepository;
  }

  /**
   * Classifica a mensagem do cliente de forma 100% genérica para qualquer produto/categoria.
   * @param {string} rawMessage
   * @returns {{ intent: string, matchedProduct?: Object, suggestedProducts?: Array<Object>, orderItems?: Array<Object> }}
   */
  route(rawMessage) {
    if (!rawMessage || typeof rawMessage !== 'string' || !rawMessage.trim()) {
      return { intent: INTENTS.GENERAL_CHAT };
    }

    const normalized = normalizeText(rawMessage);
    const cleanedQuery = cleanConversationalPrefixes(rawMessage);

    // 0. Confirmação / Fechamento de Pedido
    if (ORDER_CLOSING_PATTERNS.some((pattern) => pattern.test(normalized))) {
      return { intent: INTENTS.ORDER_CONFIRMATION };
    }

    // 1. Alteração de Dados do Pedido (Pagamento / Endereço)
    if (UPDATE_DETAILS_PATTERNS.some((pattern) => pattern.test(normalized))) {
      return { intent: INTENTS.UPDATE_ORDER_DETAILS };
    }

    // 2. Pedido de Fotos (ex: "manda foto da palmeira rabo de raposa", "tem fotos da mini cabra?")
    if (PHOTO_TRIGGER_PATTERNS.some((pattern) => pattern.test(normalized))) {
      const matchedProduct = this.catalogRepository.findProductByName(cleanedQuery) ||
                             this.catalogRepository.findProductByName(normalized);
      const categoryMatches = !matchedProduct ? this.catalogRepository.findProductsByBroadQuery(cleanedQuery) : [];

      return {
        intent: INTENTS.REQUEST_PHOTOS,
        matchedProduct: matchedProduct || null,
        suggestedProducts: categoryMatches,
      };
    }

    // 3. Detecção de Pedido Múltiplo / Solicitação de Itens (ex: "manda pra mim 3 alface, 3 rucula e 5 cebolinha")
    const parsedItems = parseOrderItems(rawMessage);
    const hasOrderVerb = ORDER_INTENT_VERBS.some((pattern) => pattern.test(rawMessage.toLowerCase()));

    if (parsedItems.length > 0 && (hasOrderVerb || parsedItems.length >= 2)) {
      const validatedOrderItems = [];
      let totalRecognized = 0;

      for (const item of parsedItems) {
        const priceMatch = item.rawName.match(/\bde\s+(?:r\$\s*)?(\d+(?:[.,]\d+)?)\b/i);
        const cleanName = item.rawName.replace(/\bde\s+(?:r\$\s*)?(\d+(?:[.,]\d+)?)\b/i, '').trim();

        const matches = this.catalogRepository.findProductsMatchingTerm(cleanName || item.rawName);

        if (matches.length === 1) {
          totalRecognized++;
          const prod = matches[0];
          let chosenPrice = null;

          if (priceMatch) {
            const rawP = parseFloat(priceMatch[1].replace(',', '.'));
            if (prod.prices.includes(rawP)) {
              chosenPrice = rawP;
            }
          }

          validatedOrderItems.push({
            quantity: item.quantity,
            rawName: cleanName || item.rawName,
            isAmbiguous: false,
            hasMultiplePrices: !chosenPrice && prod.prices.length > 1,
            targetPrice: chosenPrice,
            product: prod,
            canonicalName: prod.canonicalName,
            prices: chosenPrice ? [chosenPrice] : prod.prices,
          });
        } else if (matches.length > 1) {
          totalRecognized++;
          validatedOrderItems.push({
            quantity: item.quantity,
            rawName: cleanName || item.rawName,
            isAmbiguous: true,
            hasMultiplePrices: true,
            options: matches.map((m) => ({
              canonicalName: m.canonicalName,
              prices: m.prices,
            })),
          });
        } else {
          validatedOrderItems.push({
            quantity: item.quantity,
            rawName: item.rawName,
            isAmbiguous: false,
            product: null,
          });
        }
      }

      if (totalRecognized > 0) {
        return {
          intent: INTENTS.ORDER_REQUEST,
          orderItems: validatedOrderItems,
        };
      }
    }

    // 4. Se a busca é ampla por Categoria ou Subcategoria existente (ex: "palmeiras", "aves", "folhosas")
    const subcats = this.catalogRepository.productsBySubcategoryMap;
    const cats = this.catalogRepository.productsByCategoryMap;
    const singularQ = cleanedQuery.endsWith('s') ? cleanedQuery.slice(0, -1) : cleanedQuery;

    const isCategoryQuery = subcats.has(cleanedQuery) || subcats.has(singularQ) ||
                            cats.has(cleanedQuery) || cats.has(singularQ);

    if (isCategoryQuery) {
      const broadMatches = this.catalogRepository.findProductsByBroadQuery(cleanedQuery);
      if (broadMatches && broadMatches.length > 0) {
        return {
          intent: INTENTS.CONSULTATIVE_SALES,
          suggestedProducts: broadMatches,
        };
      }
    }

    // 5. Consulta de Produto Específico (ex: "Vocês tem mini cabra??", "Qual o valor da palmeira rabo de raposa?")
    const specificProduct = this.catalogRepository.findProductByName(cleanedQuery) ||
                            this.catalogRepository.findProductByName(normalized);

    if (specificProduct) {
      return {
        intent: INTENTS.DIRECT_PRICE,
        matchedProduct: specificProduct,
      };
    }

    // 6. Consulta de Categoria, Subcategoria ou Família Aberta remanescente
    const broadMatches = this.catalogRepository.findProductsByBroadQuery(cleanedQuery) ||
                         this.catalogRepository.findProductsByBroadQuery(normalized);

    if (broadMatches && broadMatches.length > 0) {
      return {
        intent: INTENTS.CONSULTATIVE_SALES,
        suggestedProducts: broadMatches,
      };
    }

    // 7. Fallback padrão para diálogo aberto
    return {
      intent: INTENTS.CONSULTATIVE_SALES,
      suggestedProducts: [],
    };
  }
}

module.exports = {
  INTENTS,
  MessageRouter,
  parseOrderItems,
};
