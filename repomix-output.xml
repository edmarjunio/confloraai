  const agentService = new AgentService();
  const orderService = new OrderService({ firestoreRepo, catalogRepo });
  const learningService = new LearningService({ firestoreRepo, catalogRepo });

  const service = new MessageService({
    router,
    directPriceService,
    agentService,
    catalogRepo,
    firestoreRepo,
    orderService,
    whatsappClient: mockWhatsapp,
    learningService,
  });

  const phone = '5564999990015';

  await service.orderService.createPendingOrder(
    phone,
    [{ productName: 'ALFACE CRESPA', quantity: 3, targetPrice: 8.0 }],
