  assert.match(sentToOwner.text, /Junin Conflora/i);
  assert.match(sentToOwner.text, /3x ALFACE CRESPA/i);
  assert.match(sentToOwner.text, /Valor total.*24,00/i);
  assert.match(sentToOwner.text, /Débito/i);
  assert.match(sentToOwner.text, /Avenida Alessandro Marchió, 162/i);
});
