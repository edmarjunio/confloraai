  'servicos financeiro',
  'servicos',
  'saldo devedor',
  'mao de obra',
  'taxa de entrega',
]);

function buildDriveDirectImageUrl(fileId, rawUrl) {
  if (fileId && typeof fileId === 'string' && fileId.trim().length > 10) {
    return `https://drive.google.com/uc?export=view&id=${fileId.trim()}`;
  }
  if (rawUrl && typeof rawUrl === 'string' && rawUrl.startsWith('http')) {
    return rawUrl.trim();
  }
  return null;
}

class CatalogRepository {
  /**
   * @param {Object} options
   * @param {string} options.spreadsheetId
   * @param {string} [options.sheetName='PRODUTOS']
   * @param {number} [options.cacheTtlSeconds=15]
   * @param {Array<Object>} [options.mockData=null]
   * @param {import('../database/firestore.repository').FirestoreRepository} [options.firestoreRepo=null]
   */
  constructor({
    spreadsheetId,
    sheetName = 'PRODUTOS',
    cacheTtlSeconds = 15,
    mockData = null,
    firestoreRepo = null,
  }) {
    this.spreadsheetId = spreadsheetId;
    this.sheetName = sheetName;
    this.cacheTtlMs = cacheTtlSeconds * 1000;
    this.items = [];
    this.productByNameMap = new Map();
    this.productByTagMap = new Map();
    this.productsByCategoryMap = new Map();
    this.productsBySubcategoryMap = new Map();
    this.lastCacheTime = 0;
    this.mockData = mockData;
    this.firestoreRepo = firestoreRepo;

    if (this.mockData) {
      this.loadItems(this.mockData);
    }
  }

  async refreshCatalog() {
    if (this.mockData) {
      this.loadItems(this.mockData);
      return;
    }

    if (this.isCacheValid()) {
      return;
    }

    const googleapis = getGoogleApis();
    if (!googleapis) {
      Logger.warn('Módulo googleapis não encontrado; usando dados existentes em memória.');
      return;
    }

    try {
      const auth = new googleapis.google.auth.GoogleAuth({
        scopes: ['https://www.googleapis.com/auth/spreadsheets.readonly'],
      });
      const sheets = googleapis.google.sheets({ version: 'v4', auth });

      const response = await sheets.spreadsheets.values.get({
        spreadsheetId: this.spreadsheetId,
        range: `${this.sheetName}!A1:O2000`,
      });

      const rows = response.data.values || [];
      if (rows.length < 2) {
        Logger.warn('Tabela de produtos vazia ou sem cabeçalhos.');
        return;
      }

      const headers = rows[0].map((h) => normalizeText(h));
      const idIdx = headers.indexOf('product id');
      const descIdx = headers.indexOf('descricao');
      const statusIdx = headers.indexOf('status');
      const valorIdx = headers.indexOf('valor');
      const valorNumIdx = headers.indexOf('valor num');
      const catIdx = headers.indexOf('categoria');
      const subCatIdx = headers.indexOf('subcategoria');
      const varIdx = headers.indexOf('variacao');
      const imgUrlIdx = headers.indexOf('imageurl');
      const imgFileIdIdx = headers.indexOf('imagefileid');
      const descAiIdx = headers.indexOf('descricao ia');
      const tagsAiIdx = headers.indexOf('tags ia');

      const parsedItems = [];

      for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        const status = (row[statusIdx] || 'ATIVO').trim().toUpperCase();
        if (status !== 'ATIVO') {
          continue;
        }

        const name = (row[descIdx] || '').trim();
        if (!name) {
          continue;
        }

        const rawCat = row[catIdx] || '';
        const rawSubCat = subCatIdx >= 0 ? row[subCatIdx] || '' : '';
        const normalizedCat = normalizeText(rawCat);

        if (IGNORED_CATEGORIES.has(normalizedCat)) {
          continue;
        }

        const price = valorNumIdx >= 0 && row[valorNumIdx]
          ? parseCurrencyString(row[valorNumIdx])
          : parseCurrencyString(row[valorIdx]);

        parsedItems.push({
          id: row[idIdx] || `item-${i}`,
          name,
          category: rawCat,
          subcategory: rawSubCat,
          variation: varIdx >= 0 ? row[varIdx] || '' : '',
          price,
          status: 'ATIVO',
          imageFileId: imgFileIdIdx >= 0 ? row[imgFileIdIdx] || '' : '',
          imageUrl: imgUrlIdx >= 0 ? row[imgUrlIdx] || '' : '',
          descriptionAi: descAiIdx >= 0 ? (row[descAiIdx] || '').trim() : '',
          tagsAi: tagsAiIdx >= 0 ? (row[tagsAiIdx] || '').trim() : '',
        });
      }

      this.loadItems(parsedItems);
      Logger.info(`Catálogo atualizado em tempo real. ${this.items.length} itens comerciais ativos indexados.`);
    } catch (error) {
      Logger.error('Falha ao atualizar catálogo via Google Sheets', error);
      if (this.items.length === 0) {
        throw error;
      }
    }
  }

  forceRefreshCatalog() {
    this.lastCacheTime = 0;
    return this.refreshCatalog();
  }

  loadItems(rawItems) {
    if (!Array.isArray(rawItems)) {
      return;
    }

    this.items = rawItems.filter((item) => item.status?.toUpperCase() === 'ATIVO');
    this.productByNameMap.clear();
    this.productByTagMap.clear();
    this.productsByCategoryMap.clear();
    this.productsBySubcategoryMap.clear();

    for (const item of this.items) {
      const normalizedName = normalizeText(item.name);
      const normalizedSubcat = normalizeText(item.subcategory || '');
      const normalizedCat = normalizeText(item.category || '');
      const parsedPrice = typeof item.price === 'number' ? item.price : parseCurrencyString(item.price);

      if (!this.productByNameMap.has(normalizedName)) {
        this.productByNameMap.set(normalizedName, {
          canonicalName: item.name,
          category: item.category,
          subcategory: item.subcategory,
          descriptionAi: item.descriptionAi || '',
          tags: new Set(),
          prices: [],
          images: [],
          items: [],
          variations: [],
        });
      }

      const productGroup = this.productByNameMap.get(normalizedName);
      productGroup.items.push(item);

      // Preços sem duplicidade, ordenados
      if (typeof parsedPrice === 'number' && !isNaN(parsedPrice) && parsedPrice > 0 && !productGroup.prices.includes(parsedPrice)) {
        productGroup.prices.push(parsedPrice);
        productGroup.prices.sort((a, b) => a - b);
      }

      // Descrição IA
      if (item.descriptionAi && !productGroup.descriptionAi) {
        productGroup.descriptionAi = item.descriptionAi;
      }

      // Imagens do Drive ou URL
      const directUrl = buildDriveDirectImageUrl(item.imageFileId, item.imageUrl);
      if (directUrl && !productGroup.images.includes(directUrl)) {
        productGroup.images.push(directUrl);
      }

      // Indexação de TAGS_IA da planilha
      if (item.tagsAi) {
        const rawTags = item.tagsAi.split(/[,;\n]/).map((t) => normalizeText(t)).filter((t) => t.length > 1);
        for (const tag of rawTags) {
          productGroup.tags.add(tag);
          this.productByTagMap.set(tag, productGroup);
        }
      }

      // Indexação de Subcategoria (dinâmica para qualquer categoria)
      if (normalizedSubcat) {
        if (!this.productsBySubcategoryMap.has(normalizedSubcat)) {
          this.productsBySubcategoryMap.set(normalizedSubcat, []);
        }
        this.productsBySubcategoryMap.get(normalizedSubcat).push(item);
      }

      // Indexação de Categoria (dinâmica para qualquer categoria)
      if (normalizedCat) {
        if (!this.productsByCategoryMap.has(normalizedCat)) {
          this.productsByCategoryMap.set(normalizedCat, []);
        }
        this.productsByCategoryMap.get(normalizedCat).push(item);
      }
    }

    this.lastCacheTime = Date.now();
  }

  /**
   * Localiza um produto específico pelo nome, termo composto, singular ou por TAGS_IA.
   * Se houver variantes com o mesmo radical (ex: "Mini Cabra Macho" e "Mini Cabra Fêmea"),
   * consolida os preços e variações em um único grupo representativo.
   * @param {string} query
   * @returns {Object|null}
   */
  findProductByName(query) {
    const normalizedQuery = normalizeText(query);
    if (!normalizedQuery || normalizedQuery.length < 2) {
      return null;
    }

    const singularQuery = normalizedQuery
      .split(' ')
      .map((word) => (word.length > 3 && word.endsWith('s') ? word.slice(0, -1) : word))
      .join(' ');

    const queriesToTest = [normalizedQuery];
    if (singularQuery !== normalizedQuery) {
      queriesToTest.push(singularQuery);
    }

    for (const q of queriesToTest) {
      // 1. Busca exata por nome
      if (this.productByNameMap.has(q)) {
        return this.productByNameMap.get(q);
      }

      // 2. Busca exata por TAGS_IA (sinônimos, termos regionais)
      if (this.productByTagMap.has(q)) {
        return this.productByTagMap.get(q);
      }

      // 3. Busca por correspondência de frase composta (ex: "mini cabra" -> "mini cabra macho" e "mini cabra femea")
      const matchingGroups = [];
      for (const [key, group] of this.productByNameMap.entries()) {
        if (
          key === q ||
          key.startsWith(q + ' ') ||
          key.includes(' ' + q + ' ') ||
          key.endsWith(' ' + q)
        ) {
          matchingGroups.push(group);
        }
      }

      if (matchingGroups.length === 1) {
        return matchingGroups[0];
      }

      if (matchingGroups.length > 1) {
        const allPrices = Array.from(new Set(matchingGroups.flatMap((g) => g.prices))).sort((a, b) => a - b);
        const allImages = Array.from(new Set(matchingGroups.flatMap((g) => g.images)));
        const variations = matchingGroups.map((g) => `${g.canonicalName}: ${g.prices.map(formatCurrency).join(', ')}`);

        return {
          canonicalName: matchingGroups[0].canonicalName.replace(/\s+(macho|f[eê]mea|filhote|adulto|casal)\b/i, '').trim(),
          category: matchingGroups[0].category,
          subcategory: matchingGroups[0].subcategory,
          descriptionAi: matchingGroups[0].descriptionAi || '',
          tags: new Set(matchingGroups.flatMap((g) => Array.from(g.tags))),
          prices: allPrices,
          images: allImages,
          items: matchingGroups.flatMap((g) => g.items),
          variations,
          isFamilyGroup: true,
        };
      }

      // 4. Busca por aproximação ou substring
      for (const [key, group] of this.productByNameMap.entries()) {
        if (key.includes(q)) {
          return group;
        }
      }

      for (const [tagKey, group] of this.productByTagMap.entries()) {
        if (tagKey.includes(q) || q.includes(tagKey)) {
          return group;
        }
      }
    }

    return null;
  }

  /**
   * Retorna todos os produtos que contêm o termo (útil para detectar variedades de um mesmo item, como alface).
   * Desambigua produtos de consumo vs mudas/bandejas com precisão.
   * @param {string} term
   * @returns {Array<Object>}
   */
  findProductsMatchingTerm(term) {
    const normalized = normalizeText(term);
    if (!normalized || normalized.length < 2) {
      return [];
    }

    const wantsMuda = normalized.includes('muda') || normalized.includes('bandeja');
    const matchedGroups = new Map();

    for (const [key, group] of this.productByNameMap.entries()) {
      const match = key === normalized ||
                    key.startsWith(normalized + ' ') ||
                    key.includes(' ' + normalized + ' ') ||
                    key.endsWith(' ' + normalized) ||
                    key.includes(normalized);

      if (match && !matchedGroups.has(group.canonicalName)) {
        matchedGroups.set(group.canonicalName, group);
      }
    }

    const results = Array.from(matchedGroups.values());

    // Se o cliente não pediu expressamente muda ou bandeja, prioriza produtos diretos
    if (!wantsMuda) {
      const directItems = results.filter((g) => {
        const norm = normalizeText(g.canonicalName);
        return !norm.startsWith('muda de') && !norm.startsWith('bandeja de');
      });
      if (directItems.length > 0) {
        return directItems;
      }
    }

    return results;
  }

  /**
   * Busca ampla por Categoria, Subcategoria ou Família de Produtos de forma 100% genérica.
   * Funciona para qualquer categoria (Plantas, Pets, Horta, Hortifrutti, Madeireira, etc.)
   * @param {string} broadQuery
   * @returns {Array<Object>}
   */
  findProductsByBroadQuery(broadQuery) {
    const normalized = normalizeText(broadQuery);
    if (!normalized || normalized.length < 3) {
      return [];
    }

    const singular = normalized.endsWith('s') ? normalized.slice(0, -1) : normalized;
    const matchedProducts = new Map();

    // 1. Busca por Subcategoria exata ou aproximada (ex: "palmeiras", "aves ornamentais", "folhosas")
    for (const [subcatKey, items] of this.productsBySubcategoryMap.entries()) {
      if (subcatKey === normalized || subcatKey === singular || subcatKey.startsWith(singular) || subcatKey.includes(singular)) {
        for (const item of items) {
          const groupKey = normalizeText(item.name);
          if (!matchedProducts.has(groupKey) && this.productByNameMap.has(groupKey)) {
            matchedProducts.set(groupKey, this.productByNameMap.get(groupKey));
          }
        }
      }
    }

    // 2. Busca por Categoria exata ou aproximada (ex: "pets", "horta", "hortifrutti", "plantas", "madeireira")
    for (const [catKey, items] of this.productsByCategoryMap.entries()) {
      if (catKey === normalized || catKey === singular || catKey.startsWith(singular) || catKey.includes(singular)) {
        for (const item of items) {
          const groupKey = normalizeText(item.name);
          if (!matchedProducts.has(groupKey) && this.productByNameMap.has(groupKey)) {
            matchedProducts.set(groupKey, this.productByNameMap.get(groupKey));
          }
        }
      }
    }

    // 3. Busca por família de produtos (ex: "palmeira", "alface", "porquinho da india", "codorna", "dracena")
    for (const [nameKey, group] of this.productByNameMap.entries()) {
      if (nameKey.startsWith(singular + ' ') || nameKey === singular || nameKey.includes(' ' + singular)) {
        if (!matchedProducts.has(nameKey)) {
          matchedProducts.set(nameKey, group);
        }
      }
    }

    return Array.from(matchedProducts.values());
  }

  /**
   * Adiciona uma tag aprendida em tempo de execução sem alterar a planilha.
   * @param {string} productName
   * @param {string} newTag
   */
  registerLearnedTag(productName, newTag) {
    const normalizedProd = normalizeText(productName);
    const normalizedTag = normalizeText(newTag);
    if (!normalizedTag || !normalizedProd || normalizedTag.length < 3) {
      return;
    }

    const group = this.productByNameMap.get(normalizedProd);
    if (group) {
      group.tags.add(normalizedTag);
      this.productByTagMap.set(normalizedTag, group);
      Logger.info(`Tag aprendida indexada em memória: [${normalizedTag}] -> ${group.canonicalName}`);
    }
  }

  isCacheValid() {
    return this.items.length > 0 && Date.now() - this.lastCacheTime < this.cacheTtlMs;
  }
}

module.exports = {
  CatalogRepository,
};
