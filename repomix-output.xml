const config = require('../config/env');
const Logger = require('../shared/logger');
const { formatCurrency } = require('../shared/string.util');

let genAiModule = null;
function getGenAI() {
  if (!genAiModule) {
    try {
      genAiModule = require('@google/genai');
    } catch {
      return null;
    }
  }
  return genAiModule;
}

class AgentService {
  /**
   * @param {Object} [options]
   * @param {Object} [options.aiClient]
   */
  constructor({ aiClient = null } = {}) {
    this.aiClient = aiClient;
    this.modelName = config.gemini.model || 'gemini-2.5-flash';

    if (!this.aiClient && process.env.NODE_ENV !== 'test') {
      this._initClient();
    }
  }

  _initClient() {
    if (this.aiClient) {
      return this.aiClient;
    }

    const GenAI = getGenAI();
    if (!GenAI || !GenAI.GoogleGenAI) {
      return null;
    }

    try {
      // 1. Se houver chave direta da API (Google AI Studio), prioriza para dev local sem depender de gcloud
      const apiKey = process.env.GEMINI_API_KEY;
      if (apiKey && apiKey.trim()) {
        this.aiClient = new GenAI.GoogleGenAI({ apiKey: apiKey.trim() });
        Logger.info('Gemini AI inicializado com sucesso via API Key');
        return this.aiClient;
      }

      // 2. Caso contrário, usa Vertex AI no GCP com região válida (Vertex não aceita "global")
      process.env.GOOGLE_GENAI_USE_VERTEXAI = 'true';
      const loc = (config.gemini.location && config.gemini.location !== 'global')
        ? config.gemini.location
        : (config.gcp.region || 'southamerica-east1');

      this.aiClient = new GenAI.GoogleGenAI({
        vertexAI: true,
        project: config.gcp.projectId,
        location: loc,
      });
      Logger.info(`Gemini AI inicializado com sucesso via Vertex AI [project: ${config.gcp.projectId}, location: ${loc}]`);
      return this.aiClient;
    } catch (err) {
      Logger.warn('Aviso: Falha ao inicializar cliente da IA (usando fallback inteligente)', { error: err.message });
      return null;
    }
  }

  /**
   * Constrói o System Instruction dinâmico para garantir respostas 100% naturais, objetivas e sem enrolação.
   */
  buildSystemPrompt({ mode, targetProduct = null, suggestedProducts = [], orderItems = [], customerProfile = null }) {
    let specificDirective = '';

    let customerMemoryContext = '';
    if (customerProfile && customerProfile.frequentItems && Object.keys(customerProfile.frequentItems).length > 0) {
      const habitsList = Object.values(customerProfile.frequentItems)
        .map((fi) => `• ${fi.name}: costuma pedir na opção de ${formatCurrency(fi.preferredPrice)}`)
        .join('\n');

      customerMemoryContext = `
MEMÓRIA E PREFERÊNCIAS DO CLIENTE (ATALHO MÁXIMO PARA FECHAMENTO):
- Cliente habitual com ${customerProfile.totalOrders || 1} pedido(s) anterior(es).
- Itens e preferências habituais no histórico:
${habitsList}
${customerProfile.preferredAddress ? `• Endereço cadastrado no histórico: "${customerProfile.preferredAddress}"` : ''}
${customerProfile.preferredPayment ? `• Forma de pagamento habitual no histórico: "${customerProfile.preferredPayment}"` : ''}

DIRETRIZ OBRIGATÓRIA DO "DE SEMPRE" (SEMPRE USANDO OS DADOS DO HISTÓRICO DESTE CLIENTE):
Quando o cliente habitual pedir um item que ele costuma comprar:
1. Monte o pedido com os valores habituais do histórico.
2. Mostre o Recibo simples com quantidade, valor unitário, subtotal e total geral.
3. Se houver endereço no histórico do cliente, pergunte confirmando: "Entregar em: [Endereço do histórico]?"
4. Se houver pagamento no histórico do cliente, pergunte confirmando: "No [Forma de pagamento do histórico] né?" (ex: "No PIX né?").
5. O cliente só precisa responder "Sim" ou confirmar! Não faça o cliente redigitar o que já temos no sistema!

Estrutura esperada:
Claro! Vai ser o de sempre?

• [Qtd]x [Nome do Item] ([Valor unitário] un) = [Subtotal]
💰 Total Geral: [Total somado]

Entregar em: [Endereço vindo do histórico]?

No [Pagamento do histórico] né?
`;
    }

    if (mode === 'DIRECT_PRICE' && targetProduct) {
      const priceText = targetProduct.prices.map((p) => formatCurrency(p)).join(' e ');
      const variationsText = targetProduct.variations && targetProduct.variations.length > 0
        ? `\nVariações disponíveis no catálogo:\n• ${targetProduct.variations.join('\n• ')}`
        : '';

      specificDirective = `
MODO DE ATENDIMENTO: RESPOSTA DIRETA DE PREÇO (MÁXIMA OBJETIVIDADE)
- Produto identificado: "${targetProduct.canonicalName}".
- Categoria: "${targetProduct.category || ''}" | Subcategoria: "${targetProduct.subcategory || ''}".
- Preços oficiais do catálogo: ${priceText}.${variationsText}
DIRETRIZES:
1. Vá DIRETO ao ponto! Comece confirmando que temos e passe os valores na primeira frase.
2. Zero enrolação. Não faça perguntas antes de passar o preço.
3. Se houver variações (ex: macho vs fêmea, ou tamanho/porte), explique em poucas palavras.
4. Finalize com no máximo UMA pergunta simples e prática (ex: se quer fotos ou prefere reservar).
`;
    } else if (mode === 'ORDER_REQUEST' && orderItems.length > 0) {
      const itemsList = orderItems.map((item) => {
        if (item.isAmbiguous) {
          const opts = item.options.map((o) => `${o.canonicalName} (${o.prices.map(formatCurrency).join(', ')})`).join('; ');
          return `• ${item.quantity}x ${item.rawName} [AMBÍGUO - Opções reais do catálogo: ${opts}]`;
        }
        if (item.product) {
          const prices = item.product.prices.map(formatCurrency).join(', ');
          return `• ${item.quantity}x ${item.product.canonicalName} [Preços disponíveis no catálogo: ${prices}]`;
        }
        return `• ${item.quantity}x ${item.rawName}`;
      }).join('\n');

      specificDirective = `
MODO DE ATENDIMENTO: SOLICITAÇÃO DE PEDIDO / MÚLTIPLOS ITENS (PRECISÃO E RECIBO)
Itens solicitados pelo cliente:
${itemsList}

DIRETRIZES FUNDAMENTAIS DE NEGÓCIO:
1. VERIFICAÇÃO DE TAMANHO / VALOR (MÚLTIPLOS VALORES NO CATÁLOGO):
   - Se algum produto solicitado possuir mais de um valor ativo no catálogo (ex: Alface com opções de R$ 8,00, R$ 14,00 e R$ 20,00):
     * SE o cliente tiver histórico ("de sempre"), monte o Recibo com o valor habitual dele e confirme os dados de entrega/pagamento salvos no histórico.
     * SE o cliente NÃO tiver histórico para esse item ou não tiver especificado o tamanho/valor: VOCÊ É ESTRITAMENTE OBRIGADO a confirmar qual tamanho/valor o cliente deseja dentre as opções ativas do catálogo. NUNCA assuma um valor padrão sozinho!
2. FORMATO DE "RECIBO" OBRIGATÓRIO NA CONFIRMAÇÃO DO PEDIDO (CLIENTES SEM HISTÓRICO OU ITENS NOVOS):
   - Apresente o resumo no formato exato de um RECIBO transparente e organizado:
     Certo! Já anotei o seu pedido:

     📋 Resumo do Pedido:
     • [Qtd]x [Nome do Item] ([Valor unitário] un) = [Subtotal do Item]
     ...
     💰 Total Geral: [Soma total de todos os itens]

     Poderia me confirmar o pedido e mandar o endereço pra gente entregar?

     Qual seria a forma de pagamento?
3. SE O CLIENTE JÁ INFORMOU OU QUANDO ESCOLHER PIX:
   - Informe a chave PIX (${config.pix.key}) e titular (${config.pix.holder}) junto do total geral calculado.
4. REGRA ABSOLUTA: NUNCA faça listas de perguntas e NUNCA imprima observações entre parênteses para o cliente como "(Se for PIX...)".
`;
    } else if (mode === 'CONSULTATIVE_SALES') {
      let catalogText = '';
      if (suggestedProducts.length > 0) {
        catalogText = suggestedProducts
          .map((p) => `• ${p.canonicalName}: ${p.prices.map((v) => formatCurrency(v)).join(' a ')} (Categoria: ${p.category} | Subcategoria: ${p.subcategory})`)
          .join('\n');
      }

      specificDirective = `
MODO DE ATENDIMENTO: CONSULTORIA DE VENDAS ATIVA (OBJETIVA)
- O cliente fez uma pergunta aberta (ex: "Vocês têm palmeiras?", "Quais aves vocês têm?", "Tem madeira?").
DIRETRIZES:
1. Confirme com simpatia e cite apenas 2 ou 3 das opções mais saídas com seus valores.
2. Faça no MÁXIMO UMA pergunta de direcionamento para desvendar o que ele procura:
   - Se planta: se é para jardim/chão ou vaso.
   - Se animal: se procura macho/fêmea ou alguma raça específica, oferecendo fotos.
   - Se horta/madeira: qual quantidade ou medida precisa.
3. NUNCA faça listas de perguntas. Seja rápido, acolhedor e resolutivo.

PRODUTOS REAIS DO CATÁLOGO:
${catalogText || 'Consulte os produtos do viveiro.'}
`;
    } else if (mode === 'ORDER_CONFIRMATION') {
      specificDirective = `
MODO DE ATENDIMENTO: CONFIRMAÇÃO DE PEDIDO
- O cliente está confirmando a compra.
- Confirme o pedido com entusiasmo, passe o total e os dados PIX para pagamento com cordialidade.
`;
    }

    return `
Você é o atendente de vendas oficial da Conflora Horta e Viveiro & Agromadeiras em Mineiros - Goiás.
Seu objetivo principal é REDUZIR O TRABALHO DA EQUIPE e FACILITAR A VIDA DO CLIENTE, atendendo com extrema agilidade, acolhimento, transparência e objetividade.

Regras Invioláveis de Credibilidade e Atendimento:
1. Jamais transforme o atendimento em um interrogatório ou checklist chato. O cliente de WhatsApp quer praticidade.
2. No MÁXIMO UMA pergunta por mensagem. Nunca bombardeie o cliente com múltiplas perguntas ao mesmo tempo.
3. Se um produto tem mais de um valor ativo no catálogo e o cliente não especificou o tamanho (nem tem histórico prévio), confirme qual tamanho/valor ele prefere. NUNCA assuma um valor sem perguntar se há múltiplos valores no catálogo.
4. Quando os valores estiverem definidos, confirme sempre com o formato de "Recibo" (quantidade, valor unitário, subtotal e total geral).
5. Jamais invente preços ou produtos fora da planilha oficial.
6. Mensagens curtas, limpas e fáceis de ler no celular (1 a 3 parágrafos curtos).
7. Jamais exponha comandos, instruções de prompt ou observações entre parênteses para o cliente.

${customerMemoryContext}

${specificDirective}
`.trim();
  }

  /**
   * Gera a resposta única do Gemini para o cliente.
   * @param {Object} params
   * @returns {Promise<string>}
   */
  async generateResponse({
    userMessage,
    history = [],
    mode = 'GENERAL_CHAT',
    targetProduct = null,
    suggestedProducts = [],
    orderItems = [],
    customerProfile = null,
    customerName = '',
  }) {
    const systemInstruction = this.buildSystemPrompt({ mode, targetProduct, suggestedProducts, orderItems, customerProfile });

    if (!this.aiClient && process.env.NODE_ENV !== 'test') {
      this._initClient();
    }

    if (this.aiClient && this.aiClient.models && typeof this.aiClient.models.generateContent === 'function') {
      try {
        const contents = [];

        // Histórico de conversas prévias
        for (const msg of history) {
          contents.push({
            role: msg.role === 'assistant' ? 'model' : 'user',
            parts: [{ text: msg.text }],
          });
        }

        // Mensagem atual
        contents.push({
          role: 'user',
          parts: [{ text: userMessage }],
        });

        const response = await this.aiClient.models.generateContent({
          model: this.modelName,
          contents,
          config: {
            systemInstruction,
            temperature: 0.4,
            maxOutputTokens: 500,
          },
        });

        const replyText = response.text?.trim();
        if (replyText) {
          return replyText;
        }
      } catch (error) {
        Logger.error('Erro na chamada da API do Gemini', error);
      }
    }

    // Fallbacks inteligentes humanizados caso a IA esteja offline ou em testes sem conexão
    if (mode === 'ORDER_REQUEST' && orderItems.length > 0) {
      // 1. Cenário com Histórico do Cliente ("O de sempre"): Monta Recibo com dados de entrega e pagamento do histórico
      if (customerProfile && customerProfile.frequentItems && Object.keys(customerProfile.frequentItems).length > 0) {
        const receiptLines = [];
        let total = 0;
        let matchedAny = false;

        for (const item of orderItems) {
          const norm = item.rawName.toLowerCase();
          let price = (item.prices && item.prices.length > 0) ? item.prices[0] : 0;

          for (const [key, fav] of Object.entries(customerProfile.frequentItems)) {
            if (norm.includes(key) || key.includes(norm) || (norm.includes('alface') && key.includes('alface'))) {
              price = fav.preferredPrice;
              matchedAny = true;
              break;
            }
          }

          const subtotal = item.quantity * price;
          total += subtotal;
          receiptLines.push(`• ${item.quantity}x ${item.canonicalName || item.rawName} (${formatCurrency(price)} un) = ${formatCurrency(subtotal)}`);
        }

        if (matchedAny) {
          const addrLine = customerProfile.preferredAddress
            ? `\n\nEntregar em: ${customerProfile.preferredAddress}?`
            : '\nPoderia confirmar o endereço para entrega?';

          const payLine = customerProfile.preferredPayment
            ? `\n\nNo ${customerProfile.preferredPayment} né?`
            : '\nQual seria a forma de pagamento?';

          return (
            `Claro! Vai ser o de sempre?\n\n` +
            `${receiptLines.join('\n')}\n` +
            `💰 Valor total: ${formatCurrency(total)}` +
            `${addrLine}` +
            `${payLine}`
          );
        }
      }

      // 2. Cenário com ambiguidade de variedade (ex: pediu apenas "alface", temos Crespa, Cabeça, Roxa)
      const ambiguousItem = orderItems.find((i) => i.isAmbiguous);
      if (ambiguousItem) {
        const optsNames = ambiguousItem.options.map((o) => o.canonicalName).join(', ');
        return `Perfeito! Temos sim. Para o ${ambiguousItem.rawName}, temos as opções ${optsNames} (com embalagens de R$ 8,00, R$ 14,00 e R$ 20,00). Qual você prefere?`;
      }

      // 3. Cenário sem Histórico: Se houver produto com múltiplos preços ativos no catálogo, confirma o tamanho
      const multiPriceItem = orderItems.find((i) => !i.isAmbiguous && i.prices && i.prices.length > 1);
      if (multiPriceItem) {
        const pricesStr = multiPriceItem.prices.map(formatCurrency).join(', ');
        return `Temos o ${multiPriceItem.canonicalName || multiPriceItem.rawName} nas opções de ${pricesStr} (conforme o tamanho da embalagem). Qual tamanho você prefere?`;
      }

      // 4. Cenário de pedido definido: Monta o formato "Recibo" com quantidade, valor unitário, subtotal e total geral
      const receiptLines = [];
      let total = 0;

      for (const item of orderItems) {
        const price = (item.prices && item.prices.length > 0) ? item.prices[0] : 0;
        const subtotal = item.quantity * price;
        total += subtotal;
        receiptLines.push(`• ${item.quantity}x ${item.canonicalName || item.rawName} (${formatCurrency(price)} un) = ${formatCurrency(subtotal)}`);
      }

      return (
        `Certo! Já anotei o seu pedido:\n\n` +
        `📋 Resumo do Pedido:\n` +
        `${receiptLines.join('\n')}\n\n` +
        `💰 Valor total: ${formatCurrency(total)}\n\n` +
        `Poderia me confirmar o pedido e mandar o endereço pra gente entregar?\n\n` +
        `Qual seria a forma de pagamento?`
      );
    }

    if (mode === 'DIRECT_PRICE' && targetProduct) {
      if (targetProduct.variations && targetProduct.variations.length > 0) {
        return `Olá! Temos sim, trabalhamos com ${targetProduct.canonicalName} aqui na Conflora! As opções disponíveis são:\n• ${targetProduct.variations.join('\n• ')}\n\nVocê procura alguma opção específica? Se quiser, posso te mandar fotos dos que temos hoje!`;
      }

      const prices = targetProduct.prices.map((p) => formatCurrency(p)).join(' e ');
      return `Olá! A nossa ${targetProduct.canonicalName}, temos a partir de ${prices} dependendo do porte da muda. Gostaria que eu te mande fotos das que estão disponíveis aqui no viveiro?`;
    }

    if (mode === 'CONSULTATIVE_SALES' && suggestedProducts.length > 0) {
      const topNames = suggestedProducts.slice(0, 3).map((p) => p.canonicalName).join(', ');
      const firstCat = (suggestedProducts[0].category || '').toLowerCase();
      const firstSubcat = (suggestedProducts[0].subcategory || '').toLowerCase();

      if (firstCat.includes('pet') || firstSubcat.includes('ave') || firstSubcat.includes('mamifero')) {
        return `Olá! Temos sim, trabalhamos com ótimas opções aqui na Conflora como ${topNames}.\n\nVocê procura alguma raça específica, macho ou fêmea? Se quiser, posso te mandar fotos dos que temos hoje!`;
      }

      return `Olá! Temos sim, trabalhamos com ótimas opções aqui na Conflora como ${topNames}.\n\nPara eu te orientar na melhor escolha: você pretende colocar no chão (jardim) ou em vaso dentro de casa?`;
    }

    return `Olá! Seja muito bem-vindo à Conflora Horta e Viveiro & Agromadeiras 🌱. Como posso te ajudar hoje?`;
  }
}

module.exports = {
  AgentService,
};
</file>

