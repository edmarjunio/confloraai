const config = require('../config/env');
const { formatCurrency } = require('../shared/string.util');

const ORDER_STATUS = Object.freeze({
  DISCOVERY: 'DISCOVERY',
  AWAITING_CONFIRMATION: 'AWAITING_CONFIRMATION',
  CONFIRMED_AWAITING_PAYMENT: 'CONFIRMED_AWAITING_PAYMENT',
  CONFIRMED: 'CONFIRMED',
  CANCELLED: 'CANCELLED',
});

function formatReceiptLines(items) {
  return items
    .map((item) => `• ${item.quantity}x ${item.name} (${formatCurrency(item.price)} un) = ${formatCurrency(item.subtotal)}`)
    .join('\n');
}

function formatCustomerReceipt({ items, total, address = '', paymentMethod = '', isHistory = false }) {
  const lines = formatReceiptLines(items);
  const totalText = `💰 Valor total: ${formatCurrency(total)}`;

  if (isHistory) {
    return (
      `Claro! Vai ser o de sempre?\n\n` +
      `📋 Resumo do Pedido:\n\n` +
      `${lines}\n\n` +
      `${totalText}\n\n` +
      (address ? `📍 Entregar em: ${address}\n\n` : '') +
      (paymentMethod ? `💳 Forma de pagamento: ${paymentMethod}` : '')
    ).trim();
  }

  return (
    `Certo! Já anotei o seu pedido:\n\n` +
    `📋 Resumo do Pedido:\n\n` +
    `${lines}\n\n` +
    `${totalText}\n\n` +
    `📍 Poderia me confirmar o pedido e mandar o endereço pra gente entregar?\n\n` +
    `💳 Qual seria a forma de pagamento?`
  );
}

function formatOwnerNotification(order, customerName = '', customerPhone = '') {
  const lines = formatReceiptLines(order.items);
  return (
    `🔔 *NOVA VENDA CONFLORA - PEDIDO FECHADO* 🔔\n\n` +
    `👤 *Cliente:* ${customerName || 'Cliente WhatsApp'}\n` +
    `📱 *WhatsApp:* ${customerPhone || order.phone}\n\n` +
    `📋 *Itens do Pedido:*\n` +
    `${lines}\n\n` +
    `💰 *Valor total:* ${formatCurrency(order.total)}\n` +
    (order.deliveryAddress ? `\n📍 *Endereço:* ${order.deliveryAddress}` : '') +
    (order.paymentMethod ? `\n💳 *Forma de pagamento:* ${order.paymentMethod}` : '')
  );
}

class OrderService {
  /**
   * @param {Object} dependencies
   * @param {import('../database/firestore.repository').FirestoreRepository} dependencies.firestoreRepo
   * @param {import('../catalog/catalog.repository').CatalogRepository} dependencies.catalogRepo
   */
  constructor({ firestoreRepo, catalogRepo }) {
    if (!firestoreRepo || !catalogRepo) {
      throw new Error('OrderService requires firestoreRepo and catalogRepo');
    }
    this.firestoreRepo = firestoreRepo;
    this.catalogRepo = catalogRepo;
  }

  /**
   * Cria ou atualiza um pedido pendente a partir dos itens validados.
   * @param {string} phone
   * @param {Array<{ productName: string, quantity: number, targetPrice?: number }>} requestedItems
   * @param {string} [deliveryAddress='']
   * @param {string} [paymentMethod='']
   * @returns {Promise<Object>}
   */
  async createPendingOrder(phone, requestedItems, deliveryAddress = '', paymentMethod = '') {
    const validatedItems = [];
    let total = 0;

    for (const req of requestedItems) {
      const productGroup = this.catalogRepo.findProductByName(req.productName);
      if (!productGroup || productGroup.prices.length === 0) {
        continue;
      }

      const matchedPrice = req.targetPrice && productGroup.prices.includes(req.targetPrice)
        ? req.targetPrice
        : productGroup.prices[0];

      const qty = Math.max(1, req.quantity || 1);
      const subtotal = matchedPrice * qty;
      total += subtotal;

      validatedItems.push({
        name: productGroup.canonicalName,
        price: matchedPrice,
        quantity: qty,
        subtotal,
      });
    }

    const order = {
      phone,
      items: validatedItems,
      total,
      deliveryAddress,
      paymentMethod,
      status: ORDER_STATUS.AWAITING_CONFIRMATION,
      createdAt: new Date().toISOString(),
    };

    await this.firestoreRepo.saveOrder(phone, order);
    return order;
  }

  /**
   * Atualiza dados de pagamento ou endereço de um pedido pendente.
   * @param {string} phone
   * @param {{ paymentMethod?: string, deliveryAddress?: string }} updates
   * @returns {Promise<Object|null>}
   */
  async updateOrderDetails(phone, updates = {}) {
    const order = await this.firestoreRepo.getOrder(phone);
    if (!order) {
      return null;
    }

    if (updates.paymentMethod) {
      order.paymentMethod = updates.paymentMethod;
    }
    if (updates.deliveryAddress) {
      order.deliveryAddress = updates.deliveryAddress;
    }

    order.updatedAt = new Date().toISOString();
    await this.firestoreRepo.saveOrder(phone, order);
    return order;
  }

  /**
   * Confirma o pedido, gera o recibo final e notificação para o proprietário.
   * @param {string} phone
   * @param {string} [customerName='']
   * @returns {Promise<{ order: Object, paymentInstructions: string, ownerNotification: string }|null>}
   */
  async confirmOrder(phone, customerName = '') {
    const order = await this.firestoreRepo.getOrder(phone);
    if (!order) {
      return null;
    }

    order.status = ORDER_STATUS.CONFIRMED;
    order.confirmedAt = new Date().toISOString();
    await this.firestoreRepo.saveOrder(phone, order);

    const isPix = (order.paymentMethod || '').toUpperCase().includes('PIX');
    let paymentInstructions = '';

    if (isPix) {
      paymentInstructions = (
        `✅ *Pedido Confirmado com Sucesso!*\n\n` +
        `💰 *Valor total:* ${formatCurrency(order.total)}\n` +
        `🔑 *Chave PIX:* \`${config.pix.key}\`\n` +
        `👤 *Titular:* ${config.pix.holder}\n\n` +
        `Assim que realizar o pagamento, envie a foto ou PDF do comprovante aqui para separarmos seu pedido! 🌱`
      );
    } else {
      const payDesc = order.paymentMethod || 'Dinheiro/Cartão na entrega';
      paymentInstructions = (
        `✅ *Pedido Confirmado com Sucesso!*\n\n` +
        `💰 *Valor total:* ${formatCurrency(order.total)}\n` +
        `💳 *Forma de pagamento:* ${payDesc}\n` +
        (order.deliveryAddress ? `📍 *Endereço:* ${order.deliveryAddress}\n\n` : '\n') +
        `Seu pedido já foi enviado para a nossa equipe e já está sendo separado com todo o carinho! 🌱`
      );
    }

    const ownerNotification = formatOwnerNotification(order, customerName, phone);

    return { order, paymentInstructions, ownerNotification };
  }

  formatReceipt(order, isHistory = false) {
    if (!order || !order.items) {
      return '';
    }
    return formatCustomerReceipt({
      items: order.items,
      total: order.total,
      address: order.deliveryAddress,
      paymentMethod: order.paymentMethod,
      isHistory,
    });
  }
}

module.exports = {
  ORDER_STATUS,
  OrderService,
  formatCustomerReceipt,
  formatOwnerNotification,
  formatReceiptLines,
};
</file>

<file path="src/services/message.service.js">
const config = require('../config/env');
const { INTENTS } = require('../router/message.router');
const Logger = require('../shared/logger');
const { formatCurrency } = require('../shared/string.util');
const { formatReceiptLines } = require('../orders/order.service');

class MessageService {
  /**
   * @param {Object} dependencies
   * @param {import('../router/message.router').MessageRouter} dependencies.router
   * @param {import('./direct-price.service').DirectPriceService} dependencies.directPriceService
   * @param {import('../ai/agent.service').AgentService} dependencies.agentService
   * @param {import('../catalog/catalog.repository').CatalogRepository} dependencies.catalogRepo
   * @param {import('../database/firestore.repository').FirestoreRepository} dependencies.firestoreRepo
   * @param {import('../orders/order.service').OrderService} dependencies.orderService
   * @param {import('../integrations/whatsapp.client').WhatsAppClient} dependencies.whatsappClient
   * @param {import('./learning.service').LearningService} [dependencies.learningService]
   */
  constructor({
    router,
    directPriceService,
    agentService,
    catalogRepo,
    firestoreRepo,
    orderService,
    whatsappClient,
    learningService = null,
  }) {
    this.router = router;
    this.directPriceService = directPriceService;
    this.agentService = agentService;
    this.catalogRepo = catalogRepo;
    this.firestoreRepo = firestoreRepo;
    this.orderService = orderService;
    this.whatsappClient = whatsappClient;
    this.learningService = learningService;
  }

  /**
   * Pipeline principal de atendimento com IA e suporte a fotos do Google Drive.
   *
   * @param {Object} input
   * @param {string} input.phone
   * @param {string} input.message
   * @param {string} [input.customerName='']
   * @param {string} [input.messageId='']
   * @returns {Promise<{ reply: string, intent: string, imagesSent?: number, latencyMs: number }>}
   */
  async handleCustomerMessage({ phone, message, customerName = '', messageId = '' }) {
    const startTime = performance.now();

    // 1. Prevenção de duplicidade (Idempotência da Meta)
    if (messageId) {
      const isDuplicate = await this.firestoreRepo.isDuplicateMessage(messageId);
      if (isDuplicate) {
        Logger.info(`Mensagem duplicada ignorada: ${messageId}`);
        return { reply: '', intent: 'DUPLICATE', latencyMs: 0 };
      }
      await this.firestoreRepo.markMessageProcessed(messageId);
    }

    // 2. Marcar mensagem como lida no WhatsApp
    if (messageId && this.whatsappClient) {
      this.whatsappClient.markAsRead(messageId).catch(() => {});
    }

    // 3. Garantir catálogo atualizado em tempo real
    if (!this.catalogRepo.isCacheValid()) {
      await this.catalogRepo.refreshCatalog().catch((err) => {
        Logger.warn('Aviso: usando cache existente do catálogo', { error: err.message });
      });
    }

    // 4. Salvar mensagem do cliente no histórico da conversa
    await this.firestoreRepo.appendMessage(phone, 'user', message);

    // 5. Roteamento inteligente de intenção e recuperação de perfil de preferências
    const routingResult = this.router.route(message);
    const history = await this.firestoreRepo.getSessionHistory(phone, 8);
    const customerProfile = await this.firestoreRepo.getCustomerProfile(phone);

    let reply = '';
    let imagesSentCount = 0;

    // CENÁRIO A: Pedido de Fotos do Google Drive
    if (routingResult.intent === INTENTS.REQUEST_PHOTOS) {
      const targetProducts = [];

      if (routingResult.matchedProduct) {
        targetProducts.push(routingResult.matchedProduct);
      } else if (routingResult.suggestedProducts.length > 0) {
        targetProducts.push(...routingResult.suggestedProducts.slice(0, 3));
      } else {
        for (let i = history.length - 1; i >= 0; i--) {
          const match = this.catalogRepo.findProductByName(history[i].text);
          if (match) {
            targetProducts.push(match);
            break;
          }
        }
      }

      for (const prod of targetProducts) {
        if (prod.images && prod.images.length > 0 && this.whatsappClient) {
          const priceText = prod.prices.map((p) => formatCurrency(p)).join(' e ');
          const caption = (
            `🌿 *${prod.canonicalName}*\n` +
            `💰 *Opções de valores:* ${priceText}`
          );

          for (const imgUrl of prod.images.slice(0, 2)) {
            await this.whatsappClient.sendImageMessage(phone, imgUrl, caption).catch((err) => {
              Logger.warn('Falha ao enviar imagem do WhatsApp', { error: err.message });
            });
            imagesSentCount++;
          }
        }
      }

      if (imagesSentCount > 0) {
        reply = `Enviei as fotos acima para você conferir! O que achou? Se quiser mais detalhes ou reservar alguma unidade, estou à disposição!`;
      }
    }

    // CENÁRIO B: Alteração de Dados do Pedido (ex: "Hoje vai ser no débito", "Muda para dinheiro")
    if (!reply && routingResult.intent === INTENTS.UPDATE_ORDER_DETAILS) {
      let order = await this.firestoreRepo.getOrder(phone);

      if (!order && customerProfile && customerProfile.frequentItems && Object.keys(customerProfile.frequentItems).length > 0) {
        const defaultItems = Object.values(customerProfile.frequentItems).map((fi) => ({
          productName: fi.name,
          quantity: fi.preferredQuantity || 1,
          targetPrice: fi.preferredPrice,
        }));
        order = await this.orderService.createPendingOrder(
          phone,
          defaultItems,
          customerProfile.preferredAddress || '',
          customerProfile.preferredPayment || 'PIX'
        );
      }

      if (order && order.items && order.items.length > 0) {
        let newPayment = '';
        const norm = message.toLowerCase();
        if (norm.includes('debito') || norm.includes('débito')) {
          newPayment = 'Débito';
        } else if (norm.includes('credito') || norm.includes('crédito')) {
          newPayment = 'Crédito';
        } else if (norm.includes('dinheiro')) {
          newPayment = 'Dinheiro';
        } else if (norm.includes('pix')) {
          newPayment = 'PIX';
        }

        if (newPayment) {
          await this.orderService.updateOrderDetails(phone, { paymentMethod: newPayment });
          order.paymentMethod = newPayment;
        }

        const lines = formatReceiptLines(order.items);
        reply = (
          `Perfeito! Atualizei sua forma de pagamento.\n\n` +
          `📋 Resumo do Pedido:\n\n` +
          `${lines}\n\n` +
          `💰 Valor total: ${formatCurrency(order.total)}\n\n` +
          (order.deliveryAddress ? `📍 Entregar em: ${order.deliveryAddress}\n\n` : '') +
          `💳 Forma de pagamento: ${order.paymentMethod || 'A combinar'}\n\n` +
          `Posso confirmar o envio do pedido?`
        );
      }
    }

    // CENÁRIO C: Confirmação de Pedido / Fechamento (Notifica o Proprietário no WhatsApp)
    if (!reply && routingResult.intent === INTENTS.ORDER_CONFIRMATION) {
      const confirmationResult = await this.orderService.confirmOrder(phone, customerName);
      if (confirmationResult) {
        reply = confirmationResult.paymentInstructions;

        // 1. Registra a compra no perfil de histórico do cliente para o atendimento do "de sempre"
        await this.firestoreRepo.recordCompletedOrder(
          phone,
          confirmationResult.order,
          confirmationResult.order.deliveryAddress,
          confirmationResult.order.paymentMethod
        ).catch(() => {});

        // 2. ENVIAR O RECIBO DO PEDIDO FECHADO DIRETAMENTE PARA O WHATSAPP DO DONO
        const ownerNum = config.whatsapp.ownerNumber || process.env.OWNER_WHATSAPP_NUMBER;
        if (this.whatsappClient && ownerNum && confirmationResult.ownerNotification) {
          await this.whatsappClient.sendTextMessage(
            ownerNum,
            confirmationResult.ownerNotification
          ).catch((err) => {
            Logger.warn('Falha ao enviar notificação de pedido para o proprietário', { error: err.message });
          });
        }

        // 3. Dispara o aprendizado contínuo seguro com base na venda concluída
        if (this.learningService && confirmationResult.order.items) {
          this.learningService.learnFromCompletedSale({
            purchasedItems: confirmationResult.order.items,
            conversationHistory: history,
          }).catch(() => {});
        }
      }
    }

    // Pré-registra pedido pendente caso seja solicitação com itens definidos
    if (routingResult.intent === INTENTS.ORDER_REQUEST && routingResult.orderItems) {
      const orderCandidateItems = routingResult.orderItems
        .filter((i) => !i.isAmbiguous && i.product)
        .map((i) => ({
          productName: i.canonicalName,
          quantity: i.quantity,
          targetPrice: i.targetPrice || (i.prices && i.prices[0]),
        }));

      if (customerProfile && customerProfile.frequentItems) {
        for (const item of routingResult.orderItems) {
          const norm = item.rawName.toLowerCase();
          for (const [key, fav] of Object.entries(customerProfile.frequentItems)) {
            if (norm.includes(key) || key.includes(norm) || (norm.includes('alface') && key.includes('alface'))) {
              if (!orderCandidateItems.some((ci) => ci.productName === fav.name)) {
                orderCandidateItems.push({
                  productName: fav.name,
                  quantity: item.quantity,
                  targetPrice: fav.preferredPrice,
                });
              }
            }
          }
        }
      }

      if (orderCandidateItems.length > 0) {
        await this.orderService.createPendingOrder(
          phone,
          orderCandidateItems,
          customerProfile?.preferredAddress || '',
          customerProfile?.preferredPayment || 'PIX'
        ).catch(() => {});
      }
    }

    // CENÁRIO D: Geração Humanizada via Gemini AI (Direct Price, Consultative, Order Request com "O de sempre")
    if (!reply) {
      reply = await this.agentService.generateResponse({
        userMessage: message,
        history,
        mode: routingResult.intent,
        targetProduct: routingResult.matchedProduct || null,
        suggestedProducts: routingResult.suggestedProducts || [],
        orderItems: routingResult.orderItems || [],
        customerProfile,
        customerName,
      });
    }

    // 6. Salvar resposta no histórico
    await this.firestoreRepo.appendMessage(phone, 'assistant', reply);

    // 7. Envio único e seguro via WhatsApp Cloud API para o cliente
    if (phone && this.whatsappClient && reply) {
      await this.whatsappClient.sendTextMessage(phone, reply);
    }

    const latencyMs = Math.round((performance.now() - startTime) * 100) / 100;
    Logger.info(`Mensagem processada para ${phone} em ${latencyMs}ms [intent: ${routingResult.intent}, imagesSent: ${imagesSentCount}]`);

    return {
      reply,
      intent: routingResult.intent,
      imagesSent: imagesSentCount,
      latencyMs,
    };
  }
}

module.exports = {
  MessageService,
};
</file>

