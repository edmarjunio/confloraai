{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "confloraai",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/tasks/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/webhooks/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/caixa",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/pdv",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin-gerencial",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/storefront/index.html"
      }
    ]
  }
}
