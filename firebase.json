{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "target": "loja",
    "public": "public",
    "headers": [
      {
        "source": "/storefront/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/storefront/dist/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/storefront/shell.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/storefront/dist/versioned/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/pdv/dist/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/pdv/dist/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/(?:products/[^/]+/?|configuracoes/?|shop/[^/]+(?:/(?:products/[^/]+|admin))?/?)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/storefront/sw{,-built}.js",
        "headers": [
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "reports/**",
      "**/*.jsx",
      "pdv/*.styles.js",
      "pdv/styles.css",
      "storefront/sw.js"
    ],
    "rewrites": [
      {
        "source": "/storefront/sw.js",
        "destination": "/storefront/sw-built.js"
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/reports/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/pdv-assets/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/webhook",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/store-assets/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/tasks/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/webhooks/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/caixa",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/pdv",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin-gerencial",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/storefront/shell.html"
      }
    ],
    "predeploy": [
      "npm run build:frontend"
    ]
  }
}
