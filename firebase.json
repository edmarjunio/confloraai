{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "confloraai",
    "public": "public",
    "headers": [
      {
        "source": "/storefront/sw.js",
        "headers": [
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/storefront/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "reports/**",
      "**/*.jsx",
      "pdv/*.styles.js",
      "pdv/styles.css"
    ],
    "rewrites": [
      {
        "source": "/health",
        "run": { "serviceId": "confloraai", "region": "southamerica-east1" }
      },
      {
        "source": "/reports/**",
        "run": { "serviceId": "confloraai", "region": "southamerica-east1" }
      },
      {
        "source": "/pdv-assets/**",
        "run": { "serviceId": "confloraai", "region": "southamerica-east1" }
      },
      {
        "source": "/webhook",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/store-assets/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/tasks/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/webhooks/**",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/caixa",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/pdv",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin-gerencial",
        "run": {
          "serviceId": "confloraai",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/storefront/index.html"
      }
    ]
  }
}
